generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("PRISMA_DIRECT_URL")
}

model Student {
  id           BigInt    @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(255)
  mobile       String    @db.VarChar(30)
  email        String    @unique @db.VarChar(255)
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isVerify     Boolean?  @map("Is_verify")
  deviceId     String?   @map("device_id") @db.VarChar(255)
  deviceName   String?   @map("device_name") @db.VarChar(255)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)

  @@map("Student")
}

model StudentEmailOtp {
  id        BigInt    @id @default(autoincrement())
  username  String    @db.VarChar(100)
  email     String    @db.VarChar(255)
  otpHash   String    @map("otp_hash") @db.VarChar(255)
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([username, createdAt(sort: Desc)])
  @@map("student_email_otps")
}
