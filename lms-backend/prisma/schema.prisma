generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("PRISMA_DIRECT_URL")
}

model Student {
  id           BigInt    @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(255)
  mobile       String    @db.VarChar(30)
  email        String    @unique @db.VarChar(255)
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isVerify     Boolean?  @map("Is_verify")
  deviceId     String?   @map("device_id") @db.VarChar(255)
  deviceName   String?   @map("device_name") @db.VarChar(255)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)

  @@map("Student")
}

model StudentEmailOtp {
  id        BigInt    @id @default(autoincrement())
  username  String    @db.VarChar(100)
  email     String    @db.VarChar(255)
  otpHash   String    @map("otp_hash") @db.VarChar(255)
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([username, createdAt(sort: Desc)])
  @@map("student_email_otps")
}

model AdminPresence {
  adminUsername String   @id @map("admin_username") @db.VarChar(100)
  deviceName    String?  @map("device_name") @db.VarChar(255)
  isOnline      Boolean  @default(true) @map("is_online")
  lastSeenAt    DateTime @map("last_seen_at") @db.Timestamptz(6)

  @@map("admin_presence")
}

model Course {
  id           BigInt          @id @default(autoincrement())
  title        String          @db.VarChar(255)
  description  String?         @db.Text
  thumbnailUrl String?         @map("thumbnail_url") @db.VarChar(500)
  isPublished  Boolean         @default(true) @map("is_published")
  displayOrder Int             @default(1) @map("display_order")
  createdBy    String?         @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  videos       Video[]
  materials    StudyMaterial[]

  @@map("courses")
}

model Video {
  id              BigInt   @id @default(autoincrement())
  courseId        BigInt   @map("course_id")
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  bunnyVideoId    String   @map("bunny_video_id") @db.VarChar(255)
  bunnyLibraryId  String   @map("bunny_library_id") @db.VarChar(255)
  durationSeconds Int?     @map("duration_seconds")
  thumbnailUrl    String?  @map("thumbnail_url") @db.VarChar(500)
  displayOrder    Int      @default(1) @map("display_order")
  status          String   @default("ready") @db.VarChar(50)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("videos")
}

model StudyMaterial {
  id           BigInt @id @default(autoincrement())
  courseId     BigInt @map("course_id")
  title        String @db.VarChar(255)
  filePath     String @map("file_path") @db.VarChar(500)
  fileType     String @map("file_type") @db.VarChar(50)
  fileSizeKb   Int?   @map("file_size_kb")
  displayOrder Int    @default(1) @map("display_order")
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("study_materials")
}
