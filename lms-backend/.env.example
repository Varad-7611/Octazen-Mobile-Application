# Environment variables for LMS backend
NODE_ENV=development
PORT=5000

# Database configuration
DATABASE_URL=<Your Supabase REST URL>
SUPABASE_SERVICE_ROLE_KEY=<Your Supabase Service Role Key>
OTP_SECRET=<Your OTP Secret>


# JWT Authentication configuration
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d


# Video streaming service configuration
BUNNY_STREAM_LIBRARY_ID=<library id>
BUNNY_STREAM_API_KEY=<api key>
BUNNY_CDN_HOSTNAME=<something>.b-cdn.net
BUNNY_TOKEN_SECURITY_KEY=<token authentication key>
BUNNY_SIGNED_URL_TTL_SECONDS=300

# File storage configuration
STORAGE_PATH=./uploads
MAX_PDF_SIZE_MB=25


# Payment gateway configuration (razorpay)
RAZORPAY_KEY_ID=<key id>
RAZORPAY_KEY_SECRET=<key secret>
RAZORPAY_WEBHOOK_SECRET=<webhook secret>

# Email service configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your email username>
SMTP_PASSWORD=<your email password>
SMTP_FROM_EMAIL=<your email address>
SMTP_FROM_NAME=<your name>